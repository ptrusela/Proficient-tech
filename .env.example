# Resend (email alerts)
RESEND_API_KEY=re_...

# Cloudflare R2 (statement storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=proficient-statements

# Close CRM
CLOSE_API_KEY=api_...
# Optional: set the lead status id for new statement-audit leads
CLOSE_LEAD_STATUS_ID=
# Required: set the opportunity status id for "Statement Received"
CLOSE_OPP_STATUS_STATEMENT_RECEIVED=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Alert email destination (defaults to info@proficient.tech)
AUDIT_ALERT_EMAIL=info@proficient.tech
